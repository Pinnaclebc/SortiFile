<Application x:Class="SortiFileWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Global Colors -->
        <Color x:Key="BgColor">#F6F8FA</Color>
        <Color x:Key="CardBg">#FFFFFF</Color>
        <Color x:Key="AccentColor">#FBC305</Color>
        <Color x:Key="AccentHover">#E5B003</Color>
        <Color x:Key="TextPrimary">#0F172A</Color>
        <Color x:Key="TextSecondary">#64748B</Color>
        <Color x:Key="TextMuted">#94A3B8</Color>
        <Color x:Key="BorderColor">#E2E8F0</Color>
        <Color x:Key="SuccessColor">#10B981</Color>
        <Color x:Key="WarningColor">#F59E0B</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBg}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <!-- Global iOS-Style Typography -->
        <FontFamily x:Key="IosFontFamily">Segoe UI Variable Display, Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, SF Pro Display, SF Pro Text, Inter, Segoe UI</FontFamily>

        <!-- Smooth Drop Shadow Effects -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.04"/>
        <DropShadowEffect x:Key="PillShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.06"/>
        <DropShadowEffect x:Key="PopupShadow" BlurRadius="22" ShadowDepth="6" Direction="270" Color="#0F172A" Opacity="0.14"/>
        <DropShadowEffect x:Key="FolderHoverShadow" BlurRadius="24" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.10"/>

